{
  "name": "casa-italy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "pnpm package:standalone",
    "start": "node --env-file=.env.local .next/standalone/server.js",
    "package:standalone": "node scripts/package-standalone.mjs",
    "test": "node --test tests/carousel.math.test.mjs",
    "lint": "eslint",
    "local:setup": "node scripts/local-setup.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:compat": "docker compose --env-file .env.local --profile compatibility up -d compatibility",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "admin:create": "node --env-file=.env.local scripts/admin-user.mjs",
    "test:db": "node --env-file=.env.local --test tests/db.test.mjs",
    "test:e2e": "playwright test",
    "db:check": "node --env-file=.env.local scripts/db-check.mjs",
    "test:compat": "node --env-file=.env.local scripts/test-compat.mjs",
    "package:ops": "node scripts/package-ops.mjs",
    "db:backup": "node --env-file=.env.local scripts/db-backup.mjs",
    "db:verify-restore": "node --env-file=.env.local scripts/db-backup.mjs --verify"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5"
}
